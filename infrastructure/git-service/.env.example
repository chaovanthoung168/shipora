SHIPORA_ADMIN_USERNAME=admin
SHIPORA_ADMIN_PASSWORD=replace-with-a-strong-dashboard-admin-password
SHIPORA_DB_PASSWORD=replace-with-a-different-database-password
SHIPORA_PUBLIC_URL=http://localhost:8084
SHIPORA_GITHUB_WEBHOOKS_ENABLED=false
# For a public deployment, put an HTTPS reverse proxy in front of this service.
# SHIPORA_PUBLIC_URL=https://shipora.customer.example
# SHIPORA_GITHUB_WEBHOOKS_ENABLED=true
# SHIPORA_GIT_IMAGE=your-registry/shipora-git-service:your-version
