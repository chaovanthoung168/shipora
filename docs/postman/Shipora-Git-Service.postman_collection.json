{
  "info": {
    "name": "Shipora Git Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Self-hosted GitHub setup and repository APIs. Set baseUrl, username, password. First use the Instance GitHub setup folder. Save its registration response to a JSON file and run scripts/Open-GitHubManifest.ps1 -ResponseFile <file> to submit the prefilled manifest in your browser. After registration, install the returned App and run main requests 1-6. GitHub approval is interactive. No GitHub credentials need to be copied. See docs/git-service.md."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8084",
      "type": "string"
    },
    {
      "key": "username",
      "value": "developer",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "connectionToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "choiceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "installationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "repositoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "authorizationUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "oauthState",
      "value": "",
      "type": "string"
    },
    {
      "key": "oauthCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "githubInstallationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "setupState",
      "value": "",
      "type": "string"
    },
    {
      "key": "setupCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "githubInstallUrl",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Instance GitHub setup - run once",
      "description": "Requires the Shipora instance administrator (GIT_ADMIN). Credentials are generated through the Manifest flow, encrypted in PostgreSQL, and loaded immediately. Starting setup when configured returns 409.",
      "item": [
        {
          "name": "A. Check GitHub setup status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/git/setup/github",
            "header": [],
            "description": "configured:false means run B. configured:true means skip setup and start the main GitHub connection flow."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "B. Start guided GitHub App registration",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/git/setup/github",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Save the complete JSON response to github-setup.json using Postman's Save Response. Run: ./scripts/Open-GitHubManifest.ps1 -ResponseFile ./github-setup.json. Click Continue to GitHub setup and create the App. Authenticate the callback with the same Shipora administrator credentials; it stores credentials and returns installationUrl. Open it, grant repository access, then run main requests 1-6. Do not simply open actionUrl: GitHub requires a POST form containing formFields.manifest. Next.js will submit that form automatically.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const match = /[?&]state=([^&]+)/.exec(pm.response.json().actionUrl); if (match) pm.collectionVariables.set(\"setupState\", decodeURIComponent(match[1])); }"
                ]
              }
            }
          ]
        },
        {
          "name": "C. Verify GitHub setup after browser registration",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/git/setup/github",
            "header": [],
            "description": "Expect configured:true and source:DATABASE. Open installationUrl to install the App for the desired repositories."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200 && pm.response.json().installationUrl) pm.collectionVariables.set(\"githubInstallUrl\", pm.response.json().installationUrl);"
                ]
              }
            }
          ]
        },
        {
          "name": "Optional Next.js - complete App registration",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/git/setup/github/callback",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Alternative to the automatic backend GET callback. Configure SHIPORA_GITHUB_SETUP_CALLBACK_URL to the Next.js server callback, validate state in the logged-in admin session, then exchange returned code/state with this endpoint. Never exchange a code consumed by the GET callback.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"{{setupState}}\",\n  \"code\": \"{{setupCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Start GitHub connection",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/git/connections",
        "description": "Open authorizationUrl in a browser. Approve GitHub access, authenticate the JSON callback with the same Shipora API credentials, then return here. Keep authorizationUrl and connectionToken private.",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"authorizationUrl\", data.authorizationUrl);",
              "  pm.collectionVariables.set(\"connectionToken\", data.connectionToken);",
              "  const state = /[?&]state=([^&]+)/.exec(data.authorizationUrl);",
              "  if (state) pm.collectionVariables.set(\"oauthState\", decodeURIComponent(state[1]));",
              "  [\"choiceId\", \"installationId\", \"repositoryId\", \"oauthCode\"].forEach(key => pm.collectionVariables.unset(key));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. List eligible GitHub accounts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Git-Connection-Token",
            "value": "{{connectionToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/git/connections/accounts",
        "description": "Run after callback returns authorized:true. First account UUID is saved automatically. For multiple accounts, set choiceId to the desired UUID. If empty, use installationUrl from callback to install the App, then restart request 1."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const accounts = pm.response.json(); pm.collectionVariables.unset(\"choiceId\"); if (accounts.length) pm.collectionVariables.set(\"choiceId\", accounts[0].id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Connect selected account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Git-Connection-Token",
            "value": "{{connectionToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/git/connections/accounts",
        "description": "Uses a short-lived choice UUID. Choices are consumed once.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"choiceId\": \"{{choiceId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"installationId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Synchronize repositories",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/git/installations/{{installationId}}/sync",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. List repositories",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/git/installations/{{installationId}}/repositories?page=0&size=20",
        "description": "List synchronized repositories. Add optional &q=storefront to search full names with a case-insensitive literal substring (maximum 200 characters). Filtering occurs before pagination and remains scoped to the authenticated organization and installation."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { pm.collectionVariables.unset(\"repositoryId\"); const repo = pm.response.json().find(r => r.available); if (repo) pm.collectionVariables.set(\"repositoryId\", repo.id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Get repository",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/git/repositories/{{repositoryId}}",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "6a. List repository commits",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/git/repositories/{{repositoryId}}/commits?branch=main&page=0&size=20",
        "description": "Replace main with the application's branch (URL encode it). Requires Contents read access to this connected repository. Returns full SHA, message, authorName and committedAt; never a GitHub token. Select a returned SHA when creating a deployment."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Commit array without credentials\", () => { const commits = pm.response.json(); pm.expect(commits).to.be.an('array'); commits.forEach(c => { pm.expect(c.sha).to.match(/^[0-9a-f]{40}([0-9a-f]{24})?$/); pm.expect(c).not.to.have.property('token'); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. List connected installations",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/git/installations?page=0&size=20",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Optional flows",
      "item": [
        {
          "name": "Legacy - start with known GitHub installation ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/git/connections",
            "description": "Compatibility flow. Set numeric githubInstallationId. Browser callback links directly. List connected installations and copy its Shipora UUID into installationId, then sync. No connectionToken or account-choice requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"installationId\": \"{{githubInstallationId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"authorizationUrl\", pm.response.json().authorizationUrl);"
                ]
              }
            }
          ]
        },
        {
          "name": "Next.js - exchange callback code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/git/github/callback",
            "description": "Alternative callback transport for a future Next.js server route. Configure GITHUB_CALLBACK_URL and GitHub App callback to that route. Validate OAuth state in the logged-in frontend session, then POST code/state with that user's Shipora authentication. Do not send after backend GET callback already consumed code/state. Not an extra step in requests 1–6.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"state\": \"{{oauthState}}\",\n  \"code\": \"{{oauthCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Negative tests",
      "item": [
        {
          "name": "Invalid installation ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/git/connections",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"installationId\": \"invalid\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing authentication",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/git/installations",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing connection token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/git/connections/accounts",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unsigned webhook rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-GitHub-Delivery",
                "value": "11111111-1111-1111-1111-111111111111"
              },
              {
                "key": "X-GitHub-Event",
                "value": "ping"
              }
            ],
            "url": "{{baseUrl}}/api/git/webhooks/github",
            "description": "Requires GITHUB_WEBHOOK_SECRET; otherwise returns 503.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: \"X-Shipora-Request\", value: \"true\" });"
        ]
      }
    }
  ]
}
