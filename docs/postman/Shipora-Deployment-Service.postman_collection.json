{
  "info": {
    "name": "Shipora Deployment Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Durable deployment orchestration only. No builds, pushes or runtime rollouts occur in this service. Set API login, applicationId and full commitSha, then run requests 1-5 individually. Worker requests require a separate configured LOCAL_WORKER_PASSWORD. Optional worker simulation only records status/releases; do not use it to claim that a real deployment occurred. Use disposable test data, run heartbeat within the 60-second lease and do not run all folders blindly. See docs/deployment-service.md."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "username",
      "value": "developer",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "workerUsername",
      "value": "shipora-worker",
      "type": "string"
    },
    {
      "key": "workerPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "applicationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "commitSha",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "retryKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "deploymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "deploymentVersion",
      "value": "0",
      "type": "string"
    },
    {
      "key": "jobId",
      "value": "",
      "type": "string"
    },
    {
      "key": "leaseToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "workerDeploymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "workerStatus",
      "value": "",
      "type": "string"
    },
    {
      "key": "failedDeploymentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "imageReference",
      "value": "",
      "type": "string"
    },
    {
      "key": "afterEventId",
      "value": "0",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.text()) {",
          "  const data = pm.response.json(); const url = pm.request.url.toString();",
          "  if (data.jobId && data.leaseToken) {",
          "    pm.collectionVariables.set('jobId', data.jobId); pm.collectionVariables.set('leaseToken', data.leaseToken);",
          "    pm.collectionVariables.set('workerDeploymentId', data.deployment.id); pm.collectionVariables.set('workerStatus', data.deployment.status);",
          "  }",
          "  if (data.id && data.configuration && data.status) {",
          "    if (url.includes('/internal/')) { pm.collectionVariables.set('workerStatus', data.status); pm.collectionVariables.set('workerDeploymentId', data.id); }",
          "    else { pm.collectionVariables.set('deploymentId', data.id); pm.collectionVariables.set('deploymentVersion', String(data.version)); }",
          "    if (data.status === 'FAILED') pm.collectionVariables.set('failedDeploymentId', data.id);",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Queue deployment (testing endpoint)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/deployments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicationId\": \"{{applicationId}}\",\n  \"commitSha\": \"{{commitSha}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('idempotencyKey')) pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Get deployment",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/deployments/{{deploymentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. List application deployment history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/deployments?applicationId={{applicationId}}&page=0&size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Read lifecycle events",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/deployments/{{deploymentId}}/events?afterId={{afterEventId}}&limit=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read queue diagnostics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/deployments/{{deploymentId}}/queue-status",
        "description": "Tenant-scoped worker presence, application serialization and queue readiness. Requires V5 and current Deployment Service."
      },
      "response": []
    },
    {
      "name": "5. List recorded releases",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/applications/{{applicationId}}/releases?page=0&size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Optional - worker simulation (disposable data only)",
      "description": "These calls simulate a trusted worker. They do not execute builds or deployments. Claim may return 204. Complete within 60 seconds or send heartbeats every 20 seconds. The claimed job can belong to another queued application in this organization; inspect workerDeploymentId first. Choose either the failure request or the successful lifecycle folder.",
      "item": [
        {
          "name": "1. Claim next job (separate worker login)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/internal/deployment-jobs/claims",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{workerUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{workerPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Claim is available or queue is empty', () => pm.expect([200,204]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Renew lease (repeat every 20 seconds)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/internal/deployment-jobs/{{jobId}}/heartbeats",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{workerUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{workerPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaseToken\": \"{{leaseToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulate successful lifecycle - records only, no real deployment",
          "item": [
            {
              "name": "3. Enter BUILDING",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/internal/deployment-jobs/{{jobId}}/status",
                "auth": {
                  "type": "basic",
                  "basic": [
                    {
                      "key": "username",
                      "value": "{{workerUsername}}",
                      "type": "string"
                    },
                    {
                      "key": "password",
                      "value": "{{workerPassword}}",
                      "type": "string"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"leaseToken\": \"{{leaseToken}}\",\n  \"expectedStatus\": \"PREPARING\",\n  \"status\": \"BUILDING\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "4. Enter PUSHING",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/internal/deployment-jobs/{{jobId}}/status",
                "auth": {
                  "type": "basic",
                  "basic": [
                    {
                      "key": "username",
                      "value": "{{workerUsername}}",
                      "type": "string"
                    },
                    {
                      "key": "password",
                      "value": "{{workerPassword}}",
                      "type": "string"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"leaseToken\": \"{{leaseToken}}\",\n  \"expectedStatus\": \"BUILDING\",\n  \"status\": \"PUSHING\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "5. Enter DEPLOYING (set imageReference with digest)",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/internal/deployment-jobs/{{jobId}}/status",
                "auth": {
                  "type": "basic",
                  "basic": [
                    {
                      "key": "username",
                      "value": "{{workerUsername}}",
                      "type": "string"
                    },
                    {
                      "key": "password",
                      "value": "{{workerPassword}}",
                      "type": "string"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"leaseToken\": \"{{leaseToken}}\",\n  \"expectedStatus\": \"PUSHING\",\n  \"status\": \"DEPLOYING\",\n  \"imageReference\": \"{{imageReference}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "6. Enter VERIFYING",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/internal/deployment-jobs/{{jobId}}/status",
                "auth": {
                  "type": "basic",
                  "basic": [
                    {
                      "key": "username",
                      "value": "{{workerUsername}}",
                      "type": "string"
                    },
                    {
                      "key": "password",
                      "value": "{{workerPassword}}",
                      "type": "string"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"leaseToken\": \"{{leaseToken}}\",\n  \"expectedStatus\": \"DEPLOYING\",\n  \"status\": \"VERIFYING\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "7. Record SUCCEEDED (test data only)",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/internal/deployment-jobs/{{jobId}}/status",
                "auth": {
                  "type": "basic",
                  "basic": [
                    {
                      "key": "username",
                      "value": "{{workerUsername}}",
                      "type": "string"
                    },
                    {
                      "key": "password",
                      "value": "{{workerPassword}}",
                      "type": "string"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"leaseToken\": \"{{leaseToken}}\",\n  \"expectedStatus\": \"VERIFYING\",\n  \"status\": \"SUCCEEDED\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Alternative - report worker failure at current stage",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/internal/deployment-jobs/{{jobId}}/status",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{workerUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{workerPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaseToken\": \"{{leaseToken}}\",\n  \"expectedStatus\": \"{{workerStatus}}\",\n  \"status\": \"FAILED\",\n  \"failureCode\": \"WORKER_FAILED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read claimed deployment with API login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/deployments/{{workerDeploymentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Append redacted process output (active test lease only)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{workerUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{workerPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Shipora-Request",
                "value": "true"
              }
            ],
            "url": "{{baseUrl}}/internal/deployment-jobs/{{jobId}}/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaseToken\": \"{{leaseToken}}\",\n  \"events\": [\n    {\n      \"level\": \"INFO\",\n      \"message\": \"Running production build\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Run only while this disposable test job has a current worker-owned lease. Do not print credentials. Returns 204; expired or terminal leases return 409."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Optional - retry or cancel",
      "item": [
        {
          "name": "Retry FAILED deployment (new immutable job)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{retryKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/deployments/{{failedDeploymentId}}/retries"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('retryKey')) pm.collectionVariables.set('retryKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel QUEUED deployment only",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/deployments/{{deploymentId}}/cancellations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{deploymentVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Optional - negative checks",
      "item": [
        {
          "name": "Reject missing Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/deployments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": \"{{applicationId}}\",\n  \"commitSha\": \"{{commitSha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "API user cannot claim jobs",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/internal/deployment-jobs/claims"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject wrong lease token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/internal/deployment-jobs/{{jobId}}/heartbeats",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{workerUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{workerPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaseToken\": \"00000000-0000-0000-0000-000000000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing deployment",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/deployments/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
